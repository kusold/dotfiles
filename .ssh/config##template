#Include config.d/*

Host *
{% if yadm.os == "Darwin" %}
  UseKeychain yes
{% endif %}
  AddKeysToAgent yes

{% if yadm.hostname == "mq-m-mkusold" %}
Host github.marqeta.com
  IdentityFile ~/.ssh/mkusold@mq-m-mkusold-2026-05-15T10:26:39-0600
  IdentitiesOnly yes

Host github.com
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

{% endif %}
Host truenas.local
	# Recommended by restic for sftp: https://restic.readthedocs.io/en/latest/030_preparing_a_new_repo.html#sftp
	ServerAliveInterval 60
	ServerAliveCountMax 240

Host homeassistant.local
  User root

# Rainmachine uses old SSH Algorithms
Host rainmachine 192.168.30.30
  KexAlgorithms +diffie-hellman-group1-sha1
  HostKeyAlgorithms +ssh-rsa
  PubKeyAcceptedKeyTypes +ssh-rsa
  PubKeyAcceptedAlgorithms +ssh-rsa

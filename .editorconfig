# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

# top-most EditorConfig file
root = true

# Defaults for all files. Indentation is intentionally left unset so that
# guess-indent.nvim (and other detectors) can match each file's real style.
# The language-specific sections below pin the cases that must not be guessed.
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go is always tab-indented (gofmt)
[*.go]
indent_style = tab

# Makefiles require real tabs for recipe lines
[{Makefile,GNUmakefile,*.mk,*.mak}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.yaml]
# YAML requires spaces
indent_style = space
indent_size = 2
